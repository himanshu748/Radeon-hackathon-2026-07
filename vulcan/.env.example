# Copy to .env and fill in. Every value is read from the environment;
# nothing is hardcoded in the source.

# Any OpenAI-compatible endpoint.
# Ollama (development):     http://localhost:11434/v1
# vLLM on Radeon (ROCm):    https://<host>/spaces/<instance-id>/8000/v1
VULCAN_BASE_URL=http://localhost:11434/v1

# Ollama ignores this and accepts any value. The Radeon Cloud vLLM endpoint
# requires the real per-instance key, shown on the instance status page.
VULCAN_API_KEY=local

# Must match what the backend actually serves.
# Ollama: qwen3:4b-instruct        vLLM: Qwen/Qwen3-4B-Instruct-2507
VULCAN_MODEL=qwen3:4b-instruct

# The vLLM instance serves one model, so point embeddings at the same name.
VULCAN_EMBED_MODEL=mxbai-embed-large

VULCAN_TEMPERATURE=0.2
